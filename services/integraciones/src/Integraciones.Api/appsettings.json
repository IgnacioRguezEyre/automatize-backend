{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Sync": {
    "LookbackDays": 3,
    "MaxMessages": 200,
    "IntervalMinutes": 60,
    "TimeZone": "Europe/Madrid"
  },
  "Empleos": {
    "BaseUrl": "http://localhost:5216"
  }
}
