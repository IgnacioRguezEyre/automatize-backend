# Copia este archivo como .env y cambia la contraseña. El .env no se sube a Git.
# SQL Server exige al menos 8 caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita el símbolo $ (Docker Compose lo interpreta).
MSSQL_SA_PASSWORD=Cambia.Esta.Clave1
MSSQL_PORT=1433

# Solo para levantar Integraciones en Docker (docker compose --profile app). En Visual Studio se usan user-secrets.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
